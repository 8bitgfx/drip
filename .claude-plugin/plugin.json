{
  "name": "drip",
  "displayName": "Drip",
  "version": "0.2.1",
  "description": "Give Claude drip: a real designer's process for coding agents. Run /drip:start and Claude studies Dribbble references, builds a moodboard for you to pick a direction from, writes a design system, builds with real components and fit-checks its own work on screenshots. Opt-in: it only steps in when you start it.",
  "author": {
    "name": "Drip contributors"
  },
  "license": "MIT",
  "keywords": [
    "design",
    "ui",
    "ux",
    "frontend",
    "moodboard",
    "dribbble",
    "design-system",
    "taste",
    "anti-slop"
  ],
  "network": {
    "hosts": [
      "dribbble.com",
      "cdn.dribbble.com",
      "api.iconify.design",
      "api.fontsource.org",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "commons.wikimedia.org",
      "upload.wikimedia.org",
      "api.openverse.org",
      "api.unsplash.com",
      "images.unsplash.com",
      "api.pexels.com",
      "images.pexels.com",
      "api.openai.com",
      "generativelanguage.googleapis.com",
      "ui.shadcn.com",
      "coss.com",
      "www.kibo-ui.com",
      "magicui.design",
      "ui.aceternity.com",
      "reactbits.dev",
      "motion-primitives.com",
      "animate-ui.com",
      "www.cult-ui.com"
    ]
  },
  "skills": [
    "./skills/"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "drip": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dist/drip-mcp.mjs"
      ]
    }
  }
}
