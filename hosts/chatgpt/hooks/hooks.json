{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" SessionStart",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" UserPromptSubmit",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" PreToolUse",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" PostToolUse",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" PostToolUse"
          }
        ]
      },
      {
        "matcher": "drip_start",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" PostToolUse",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" Stop",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" Stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hosts/codex.mjs\" SubagentStop",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/hosts/codex.mjs\" SubagentStop"
          }
        ]
      }
    ]
  }
}
